{%- comment -%}
  Usage: {% render 'language-selector', section_id: section.id %}
  Renders nothing when the store only has one published language.
{%- endcomment -%}
{%- if localization.available_languages.size > 1 -%}
  {%- assign form_id = 'LanguageSelector-' | append: section_id -%}
  {%- form 'localization', id: form_id, class: 'lang-select' -%}
    <input type="hidden" name="return_to" value="{{ request.path }}">
    <ul class="lang-select-list" role="list" aria-label="{{ 'localization.language_label' | t }}">
      {%- for language in localization.available_languages -%}
        <li>
          {%- if language.iso_code == localization.language.iso_code -%}
            <span aria-current="true" lang="{{ language.iso_code }}">{{ language.endonym_name | capitalize }}</span>
          {%- else -%}
            <button type="submit" name="locale_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}">{{ language.endonym_name | capitalize }}</button>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endform -%}
{%- endif -%}
