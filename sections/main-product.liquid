<section class="section wrap">
  <div class="feature inner" style="padding-block:0">

    <!-- Product media -->
    <div data-reveal>
      <div class="visual">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 900 | image_tag: class: 'shot', alt: product.title, id: 'MainProductImage' }}
        {%- else -%}
          <img class="shot" id="MainProductImage" src="{{ 'litter-vanilla-cutout.png' | asset_url }}" alt="{{ product.title }}">
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="thumbs" role="list">
          {%- for image in product.images -%}
            <button type="button" class="thumb{% if image == product.featured_image %} on{% endif %}" role="listitem"
              data-full="{{ image | image_url: width: 900 }}"
              aria-label="{{ 'products.product.view_image' | t: index: forloop.index, title: product.title }}">
              {{ image | image_url: width: 160 | image_tag: alt: image.alt, loading: 'lazy', widths: '80,160' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Product info -->
    <div data-reveal data-delay="1">
      {%- if product.type != blank -%}
        <span class="eyebrow">{{ product.type }} · {{ product.vendor }}</span>
      {%- endif -%}
      <h1 style="font-size:clamp(28px,3.8vw,46px);margin:14px 0 0;letter-spacing:-.02em">{{ product.title }}</h1>

      {%- assign current_variant = product.selected_or_first_available_variant -%}

      {%- if section.settings.promo_message != blank -%}
        <div style="margin-top:14px;font-size:13px;font-weight:600;color:var(--gold-deep)">
          🎉 {{ section.settings.promo_message }}
        </div>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="desc" style="margin-top:18px;color:var(--ink-70);font-size:16px;line-height:1.7;max-width:48ch">
          {{ product.description }}
        </div>
      {%- endif -%}

      {%- assign key_benefits = product.metafields.custom.key_benefits | metafield_tag -%}
      {%- assign how_to_use = product.metafields.custom.how_to_use | metafield_tag -%}
      {%- assign product_details = product.metafields.custom.product_details | metafield_tag -%}
      {%- if key_benefits != blank or how_to_use != blank or product_details != blank -%}
        <div class="prow-group" style="margin-top:20px">
          {%- render 'collapsible-row', title: 'Key Benefits', content: key_benefits -%}
          {%- render 'collapsible-row', title: 'How to Use', content: how_to_use -%}
          {%- render 'collapsible-row', title: 'Product Details', content: product_details -%}
        </div>
      {%- endif -%}

      {%- if product.variants.size > 1 -%}
        <div class="vlabel">{{ 'products.product.choose_size' | t }}</div>
        <div class="size-pills">
          {%- for variant in product.variants -%}
            <button class="size-pill{% if variant == current_variant %} on{% endif %}"
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price }}"
              {%- unless variant.available -%} disabled{%- endunless -%}>
              {{ variant.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="buy" style="margin-top:28px;display:flex;gap:14px;flex-wrap:wrap">
        {%- if current_variant.available -%}
          <button class="btn btn--lg bpc-atc" data-variant-id="{{ current_variant.id }}">
            {{ 'products.product.add_to_cart' | t }} · {{ current_variant.price | money }}
          </button>
        {%- else -%}
          <button class="btn btn--lg" disabled style="opacity:.5;cursor:not-allowed">{{ 'products.product.sold_out' | t }}</button>
        {%- endif -%}
        <a href="{{ routes.collections_url }}/all" class="btn btn--ghost btn--lg">{{ 'products.product.continue_shopping' | t }}</a>
      </div>

      <!-- Trust badges -->
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
        {%- if section.settings.trust_badge_1 != blank -%}
          <span style="font-size:12px;color:var(--ink-70);background:var(--card);border:1px solid var(--line-soft);border-radius:30px;padding:8px 14px">✓ {{ section.settings.trust_badge_1 }}</span>
        {%- endif -%}
        {%- if section.settings.trust_badge_2 != blank -%}
          <span style="font-size:12px;color:var(--ink-70);background:var(--card);border:1px solid var(--line-soft);border-radius:30px;padding:8px 14px">✓ {{ section.settings.trust_badge_2 }}</span>
        {%- endif -%}
        {%- if section.settings.trust_badge_3 != blank -%}
          <span style="font-size:12px;color:var(--ink-70);background:var(--card);border:1px solid var(--line-soft);border-radius:30px;padding:8px 14px">✓ {{ section.settings.trust_badge_3 }}</span>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<style>
.visual{position:relative;display:grid;place-items:center;aspect-ratio:1/1;background:radial-gradient(120% 100% at 50% 20%,#fff,var(--page-2));border-radius:10px;overflow:hidden;box-shadow:inset 0 1px 0 #fff,var(--shadow-sm)}
.visual img.shot{height:84%;object-fit:contain;filter:drop-shadow(0 34px 40px rgba(0,0,64,.3))}
.thumbs{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.thumb{width:64px;height:64px;padding:0;border-radius:8px;border:2px solid var(--line-soft);background:var(--card);overflow:hidden;cursor:pointer;display:grid;place-items:center;transition:border-color .15s ease}
.thumb img{width:100%;height:100%;object-fit:contain}
.thumb:hover{border-color:var(--ink-70)}
.thumb.on{border-color:var(--gold-deep, var(--ink))}
</style>

<script>
/* Variant switcher for product page */
document.addEventListener('DOMContentLoaded', function() {
  var addToCartLabel = {{ 'products.product.add_to_cart' | t | json }};
  var shopCurrency = {{ shop.currency | json }};
  var pills = document.querySelectorAll('.size-pill');
  var atcBtn = document.querySelector('.bpc-atc');
  var mainImage = document.getElementById('MainProductImage');
  var thumbs = document.querySelectorAll('.thumb');

  thumbs.forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      if (!mainImage || !thumb.dataset.full || thumb.classList.contains('on')) return;
      thumbs.forEach(function(t) { t.classList.remove('on'); });
      thumb.classList.add('on');
      mainImage.removeAttribute('srcset');
      mainImage.src = thumb.dataset.full;
    });
  });

  function fmtPrice(cents) {
    var amount = cents / 100;
    var currency = (window.bpcData && window.bpcData.cart && window.bpcData.cart.currency && window.bpcData.cart.currency.iso_code) || shopCurrency;
    try {
      return new Intl.NumberFormat(document.documentElement.lang || undefined, { style: 'currency', currency: currency }).format(amount);
    } catch (e) {
      return currency + ' ' + amount.toFixed(2);
    }
  }

  pills.forEach(function(btn) {
    btn.addEventListener('click', function() {
      pills.forEach(function(x) { x.classList.remove('on'); });
      btn.classList.add('on');
      if (atcBtn && btn.dataset.variantId) {
        atcBtn.dataset.variantId = btn.dataset.variantId;
        if (btn.dataset.price) {
          var formatted = fmtPrice(parseInt(btn.dataset.price, 10));
          atcBtn.textContent = addToCartLabel + ' · ' + formatted;
        }
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "promo_message",
      "label": "Promo message",
      "info": "e.g. \"Buy 3, get 30% off — automatically applied at checkout\". Leave blank to hide."
    }
  ]
}
{% endschema %}
