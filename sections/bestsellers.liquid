{%- assign bs_collection = collections[section.settings.collection] -%}
{%- if bs_collection == blank -%}
  {%- assign bs_collection = collections['all'] -%}
{%- endif -%}

{%- assign bs_products = bs_collection.products | where_exp: "product", "product.tags contains 'bestseller' or product.tags contains 'new'" -%}
{%- assign bs_products = bs_products | slice: 0, section.settings.products_count -%}

<!-- BS-DEBUG2: size={{ bs_products.size }} -->
{%- for p in bs_products -%}
<!-- BS-DEBUG2-ITEM: title="{{ p.title }}" handle="{{ p.handle }}" url="{{ p.url }}" featured_image="{{ p.featured_image }}" vendor="{{ p.vendor }}" -->
{%- endfor -%}

<section class="section wrap">
  <div class="reviews-head" style="margin-bottom:48px" data-reveal>
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section-title" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
    <a href="{{ bs_collection.url | default: routes.collections_url | append: '/all' }}" class="link-underline">
      {{ 'sections.bestsellers.view_all' | t }} <span id="bs-arw"></span>
    </a>
  </div>

  <div class="grid grid-4" data-reveal>
    {%- for product in bs_products -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bestsellers",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Most loved"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Only products tagged 'bestseller' or 'new' are shown. Choose a collection to narrow the search, or leave blank to search all products."
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [{ "name": "Bestsellers" }]
}
{% endschema %}
